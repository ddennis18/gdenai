# --- LLM Configuration (Groq / OpenAI Compatible) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=qwen/qwen3.8-27b

# --- Embedding Model Configuration ---
# This uses FastEmbed (runs locally on the server, no API keys needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- RAG & Search Parameters ---
TOP_K=5
SIMILARITY_THRESHOLD=0.25
SESSION_TTL_MINUTES=45

# --- Frontend URL (For CORS Security) ---
# Use a comma-separated list if you need to allow both local and live URLs
# Example: http://localhost:8080,https://gdenai-1.onrender.com
FRONTEND_URL=http://localhost:8080